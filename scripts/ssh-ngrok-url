#!/usr/bin/env bash
# Mostra o endereço atual do túnel TCP do SSH no ngrok (0.tcp.sa.ngrok.io:PORTA).
# A porta muda a cada restart do serviço ngrok-ssh — use este script para descobrir.
for host in 172.18.0.1 127.0.0.1; do
  url=$(curl -s -m 3 "http://$host:4041/api/tunnels" 2>/dev/null | python3 -c "import sys,json;d=json.load(sys.stdin);print((d.get('tunnels') or [{}])[0].get('public_url',''))" 2>/dev/null)
  if [ -n "$url" ]; then echo "ssh decsv@${url#tcp://}"; exit 0; fi
done
echo "ngrok ssh: túnel não encontrado (serviço ngrok-ssh parado?)" >&2
exit 1
