# ==============================================================================
# HOMEHUB - Configurações de Ambiente
# ==============================================================================

# Portas dos Serviços
PORT=3000
NGINX_PORT=8000
PORTAINER_PORT=9000

# Bancos de Dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui
POSTGRES_DB=postgres

MYSQL_ROOT_PASSWORD=defina_uma_senha_forte_aqui
MYSQL_DATABASE=default_db

# RideCheck DB
RIDECHECK_DB_USER=ridecheck
RIDECHECK_DB_PASSWORD=defina_uma_senha_forte_aqui
RIDECHECK_DB_NAME=ridecheck

# Segurança & Autenticação
AUTH_SECRET=gere_uma_chave_secreta_aleatoria_32_bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=defina_sua_senha_de_admin

# Cloudflare Tunnels (Zero-Trust)
CLOUDFLARE_TUNNEL_TOKEN=seu_token_de_tunel_cloudflare_aqui
DOMAIN=decamservice.com
